# QuizWave backend configuration
# Render injects PORT automatically — do not override it.
PORT=4000
NODE_ENV=development

# CORS — comma-separated allowed origins (Express + Socket.io).
# Production (Render): set to your Vercel URL(s), e.g.
#   https://quizwave.vercel.app
CORS_ORIGINS=http://localhost:5173

# Auth — REQUIRED in production (Render: set via dashboard, or generateValue in render.yaml).
# A missing JWT_SECRET crashes the server when NODE_ENV=production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Storage driver: "memory" (default, zero setup) | "postgres" (adapter ready)
# NOTE: memory storage is lost on every restart/redeploy — fine for demos.
STORAGE_DRIVER=memory

# Cache / Pub-Sub driver: "memory" (default) | "redis" (adapter ready)
CACHE_DRIVER=memory

# Postgres (used when STORAGE_DRIVER=postgres)
# Local: supabase start (repo root) → http://localhost:54322?schema=public
# Hosted Supabase: use the Session pooler URL (transaction mode, port 6543).
# DATABASE_URL=postgres://user:password@localhost:54322/postgres
# Then: npm run prisma:deploy

# Redis (used when CACHE_DRIVER=redis)
# REDIS_URL=redis://localhost:6379

# Media storage: "local" (default) | "s3" (adapter ready)
# On Render the filesystem is ephemeral — uploaded files vanish on restart.
# Prefer pasting external image/audio URLs in the quiz builder for demos.
MEDIA_DRIVER=local
MEDIA_DIR=uploads
# S3_BUCKET=quizwave-media
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
